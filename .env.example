# ===== Ayushman-Shield Configuration =====

# Google Gemini API Key (Required)
# Get from: https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Sarvam AI API Key (Required for voice features)
# Get from: https://console.sarvam.ai
SARVAM_API_KEY=your_sarvam_api_key_here

# Qdrant Configuration
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_COLLECTION=hbp_2022_packages

# Application Settings
DEBUG=true
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]

# Playwright
PLAYWRIGHT_HEADLESS=false

# CGRMS Portal URL
CGRMS_URL=https://cgrms.pmjay.gov.in

# File Storage
UPLOAD_DIR=./uploads
REPORTS_DIR=./reports
VOICE_DIR=./voice_outputs

# Frontend URL (for Next.js)
NEXT_PUBLIC_API_URL=http://localhost:8000
